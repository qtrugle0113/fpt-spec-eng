# Không cần copy file này để chạy local. Không đặt secret thật trong environment.
# Chọn Compose provider trong shell trước podman compose; xem README.
COMPOSE_PROJECT_NAME=aat
# Các cổng mặc định chỉ bind loopback.
AAT_FRONTEND_PORT=3000
AAT_BACKEND_PORT=8000
AAT_AIRFLOW_PORT=8080
# Chỉ local/demo loopback: fresh bootstrap tạo admin/admin. Init lại không reset.
# Ngoài local/demo phải đặt 0 và quản lý credentials riêng.
AAT_LOCAL_DEMO_AUTH=1
